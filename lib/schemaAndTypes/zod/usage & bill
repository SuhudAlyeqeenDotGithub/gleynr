import { z } from "zod";

export const billStatuses = ["Paid", "Not Charged", "Pending", "Failed"];
export const currencies = ["USD", "EUR", "GBP"];
export const usageFields = ["Storage", "API Calls", "Users"];

export const billSchema = z.object({
  id: z.string(),
  subscriptionId: z.string(),
  periodStartDate: z.date(),
  periodEndDate: z.date(),
  period: z.string(), // e.g., "June 2026"
  status: z.enum(billStatuses),
});
export type Bill = z.infer<typeof billSchema>;

export const billRatesSchema = z.object({
  id: z.string(),
  usageField: z.enum(usageFields),
  rateHistory: z.array(
    z.object({
      rate: z.number(),
      effectiveFrom: z.date(),
      effectiveTill: z.date().nullable(),
      currency: z.enum(currencies).default("USD"),
    }),
  ),
});
export type BillRates = z.infer<typeof billRatesSchema>;

